NODE_ENV=development
HOST=localhost
PORT=5300
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-database-password
DB_NAME=bloghub
# Enable for hosted databases such as Supabase; keep false for local PostgreSQL.
DB_SSL=false
# Optional CA certificate path, relative to the backend folder or absolute.
# For Supabase: DB_SSL=true and DB_SSL_CA_FILE=certs/supabase-ca.crt
DB_SSL_CA_FILE=
# Generate a random secret locally; do not commit it.
JWT_SECRET=
FRONTEND_ORIGINS=http://localhost:3000

# Blog cover images. The secret key is backend-only; never use NEXT_PUBLIC_ for it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=blog-images

# Optional: the Google web OAuth client ID used by the future Auth.js frontend.
# Google login returns 503 when unset; email/password login still works.
# The Google client SECRET belongs only on the Next.js server, not in this backend.
GOOGLE_CLIENT_ID=

# Configure locally when creating the first admin with npm run seed:admin.
ADMIN_EMAIL=beeadmin@gmail.com
ADMIN_DISPLAY_NAME=Admin
ADMIN_PASSWORD=

# Optional demo account password for npm run seed (default: BlogHubDemo2026!).
SEED_PASSWORD=BlogHubDemo2026!

# Used only for forgot-password emails. Keep real credentials in local .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
