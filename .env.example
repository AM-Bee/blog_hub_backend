NODE_ENV=development
HOST=localhost
PORT=5300
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-with-your-local-database-password
DB_NAME=bloghub
# Enable for hosted databases such as Supabase; keep false for local PostgreSQL.
DB_SSL=false
# Optional CA certificate path, relative to the backend folder or absolute.
# For Supabase: DB_SSL=true and DB_SSL_CA_FILE=certs/supabase-ca.crt
DB_SSL_CA_FILE=
# Generate a random secret locally; do not commit it.
JWT_SECRET=
FRONTEND_ORIGINS=http://localhost:3000

# Blog cover images. The secret key is backend-only; never use NEXT_PUBLIC_ for it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=blog-images

# Optional: the Google web OAuth client ID used by the future Auth.js frontend.
# Google login returns 503 when unset; email/password login still works.
# The Google client SECRET belongs only on the Next.js server, not in this backend.
GOOGLE_CLIENT_ID=

# Configure locally when creating the first admin with npm run seed:admin.
ADMIN_EMAIL=beeadmin@gmail.com
ADMIN_DISPLAY_NAME=Admin
ADMIN_PASSWORD=

# Optional demo account password for npm run seed (default: BlogHubDemo2026!).
SEED_PASSWORD=BlogHubDemo2026!

# Used only for forgot-password emails. Keep real credentials in local .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional polling inside the existing web service (no separate worker required).
# Free Render web services pause polling while asleep; no delivery-time guarantee.
EXPO_PUSH_IN_WEB=false
# Separate worker alternative: enables only npm run start:push-worker.
EXPO_PUSH_ENABLED=false
# Optional: server-side Expo access token if Expo push access security is enabled.
EXPO_ACCESS_TOKEN=

# Public Contact Us API. Google reCAPTCHA v2 Checkbox secret stays backend-only.
# Exact hostnames only: no scheme, path, port, or wildcard. Replace the example domain.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,bloghub.example.com
# Contact sends only through Gmail API over HTTPS. All five settings are required
# at web startup. Authorize only gmail.send with a dedicated sending account.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
CONTACT_SUPPORT_EMAIL=
# Keep SMTP_* above: password-reset emails still use the existing SMTP service.
